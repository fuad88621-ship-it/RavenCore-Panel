# ── Raven Panel — environment ──────────────────────────────
# Generate secrets with: openssl rand -hex 32
# (install-panel.sh does this automatically)

DB_PASSWORD=change-me
SESSION_SECRET=change-me
AGENT_TOKEN=change-me
CONSOLE_SECRET=change-me

# ── Domains ────────────────────────────────────────────────
# Both must point to this VPS (A records). The panel URL is
# where users log in; the node URL is ONLY used for the browser
# console WebSocket (the agent API itself stays internal).
PANEL_URL=https://panel.yourdomain.com
NODE_URL=https://node.yourdomain.com
NODE_FQDN=node.yourdomain.com

# Local node (auto-registered on first boot)
NODE_NAME=Node-01
NODE_MEMORY_MB=7680
NODE_DISK_MB=80000
NODE_CPU_CORES=4
